{
  "redirects": [
    { "source": "/legal", "destination": "https://burgtv.com/legal/", "statusCode": 301 },
    { "source": "/legal/", "destination": "https://burgtv.com/legal/", "statusCode": 301 },
    { "source": "/legal/index.html", "destination": "https://burgtv.com/legal/", "statusCode": 301 },
    { "source": "/legal/:doc(terms|privacy|cookies|aup|dmca|good-faith|transparency|delete-account|faq).html", "destination": "https://burgtv.com/legal/:doc/", "statusCode": 301 },
    { "source": "/legal/:doc(terms|privacy|cookies|aup|dmca|good-faith|transparency|delete-account|faq)", "destination": "https://burgtv.com/legal/:doc/", "statusCode": 301 },
    { "source": "/play/:doc(terms|privacy).html", "destination": "https://burgtv.com/legal/play/:doc/", "statusCode": 301 },
    { "source": "/play/:doc(terms|privacy)", "destination": "https://burgtv.com/legal/play/:doc/", "statusCode": 301 }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "admin.burgtv.com" }],
      "destination": "/admin/:path*"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag",          "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options",       "value": "DENY" },
        { "key": "X-Content-Type-Options","value": "nosniff" },
        { "key": "Referrer-Policy",       "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",    "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
