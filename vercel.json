{
  "redirects": [
    { "source": "/legal", "destination": "https://burgtv.com/legal/", "statusCode": 301 },
    { "source": "/legal/", "destination": "https://burgtv.com/legal/", "statusCode": 301 },
    { "source": "/legal/index.html", "destination": "https://burgtv.com/legal/", "statusCode": 301 },
    { "source": "/legal/:doc(terms|privacy)(\\.html)?", "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPad|iPod).*" }], "destination": "https://burgtv.com/legal/ios/:doc/", "statusCode": 302 },
    { "source": "/legal/:doc(terms|privacy)(\\.html)?", "has": [{ "type": "header", "key": "user-agent", "value": "Mozilla/5\\.0 \\(Linux; Android.*" }], "destination": "https://burgtv.com/legal/android/:doc/", "statusCode": 302 },
    { "source": "/legal/:doc(terms|privacy|cookies|aup|dmca|good-faith|transparency|delete-account|faq).html", "destination": "https://burgtv.com/legal/:doc/", "statusCode": 301 },
    { "source": "/legal/:doc(terms|privacy|cookies|aup|dmca|good-faith|transparency|delete-account|faq)", "destination": "https://burgtv.com/legal/:doc/", "statusCode": 301 },
    { "source": "/play/:doc(terms|privacy).html", "destination": "https://burgtv.com/legal/play/:doc/", "statusCode": 301 },
    { "source": "/play/:doc(terms|privacy)", "destination": "https://burgtv.com/legal/play/:doc/", "statusCode": 301 }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "admin.burgtv.com" }],
      "destination": "/admin/:path*"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/collega(/?)(.*)",
      "headers": [
        { "key": "Referrer-Policy",  "value": "no-referrer" },
        { "key": "X-Frame-Options",  "value": "DENY" },
        { "key": "Cache-Control",    "value": "no-store" },
        { "key": "X-Robots-Tag",     "value": "noindex" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'sha256-P0ZHObhxeyoE6Iq5QdvSlQnaCWqsL5nPyzsOxbPHcIU='; style-src 'self' 'sha256-Z6JCOurybUP1ODZo5gYKcZZIIu8QM76i24QBlPeArCc='; img-src 'self'; font-src 'self'; connect-src https://api.burgtv.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" }
      ]
    },
    { "source": "/assets/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/logo-240.webp", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    { "source": "/assets/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag",          "value": "noindex, nofollow, noarchive" },
        { "key": "X-Frame-Options",       "value": "DENY" },
        { "key": "X-Content-Type-Options","value": "nosniff" },
        { "key": "Referrer-Policy",       "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",    "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.burgtv.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" },
        { "key": "Cache-Control",         "value": "no-store" }
      ]
    },
    {
      "source": "/reset-password.html",
      "headers": [
        { "key": "Referrer-Policy",  "value": "no-referrer" },
        { "key": "X-Frame-Options",  "value": "DENY" },
        { "key": "Cache-Control",    "value": "no-store" },
        { "key": "X-Robots-Tag",     "value": "noindex" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://burgtv.com; font-src 'self'; connect-src https://api.burgtv.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" }
      ]
    }
  ]
}
